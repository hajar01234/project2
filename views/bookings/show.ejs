<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Booking Details</title>
    <link rel="stylesheet" href="/css/style.css">

</head>

<body>
    <%- include('../partials/navbar') %>
        <div class="booking-details-container">

            <div class="booking-details-card">
                <h1>Booking Details</h1>

                <h2>
                    <%= booking.movie ? booking.movie.title : "Movie unavailable" %>
                </h2>

                <p>Date: <%= showtime ? showtime.date.toDateString() : "Not available" %>
                </p>

                <p>Time: <%= showtime ? showtime.time : "Not available" %>
                </p>

                <p>Seats: <%= booking.seats.join(", ") %></p>

    <p>Number of Tickets: <%= booking.seats.length %></p>

    <p>Total Price: <%= booking.totalPrice.toFixed(3) %> BHD</p>

    <p>Status: <%= booking.status %></p>
    <% if (booking.status === "Confirmed") { %>

                        <a href="/bookings/<%= booking._id %>/edit">
                            <button type="button">Edit Booking</button>
                        </a>
                        <button type="button" id="cancelBooking">Cancel Booking </button>

                        <% } %>
            </div>
<div id="cancelPopup" class="cancel-popup" hidden>
                <div class="cancel-popup-card">

                    <h2 id="popupTitle">Cancel Booking?</h2>

                    <p id="popupMessage">
                        Are you sure you want to cancel this booking?
                    </p>

                    <button type="button" id="confirmCancel">
                        Yes, Cancel Booking
                    </button>

                    <button type="button" id="keepBooking">
                        No, Keep Booking
                    </button>

                    <button type="button" id="doneButton" style="display: none;">
                        Done
                    </button>

                </div>
            </div>



            <a href="/bookings/my-bookings" class="back-to-bookings">Back to My Bookings</a>

        </div>
        <script>
            const cancelButton = document.querySelector("#cancelBooking");
            const cancelPopup = document.querySelector("#cancelPopup");

            const popupTitle = document.querySelector("#popupTitle");
            const popupMessage = document.querySelector("#popupMessage");

            const confirmCancel = document.querySelector("#confirmCancel");
            const keepBooking = document.querySelector("#keepBooking");
            const doneButton = document.querySelector("#doneButton");

            if (cancelButton) {
                cancelButton.addEventListener("click", () => {
                    cancelPopup.style.display = "flex";
                });
                keepBooking.addEventListener("click", () => {
                    cancelPopup.style.display = "none";
                });
                confirmCancel.addEventListener("click", async () => {

                    confirmCancel.disabled = true;

                    try {
                        const response = await fetch(
                            "/bookings/<%= booking._id %>/cancel",
                            {
                                method: "PATCH"
                            }
                        );

                        const result = await response.text();

                        if (response.ok && result === "Booking Cancelled!") {

                            popupTitle.textContent = "Booking Cancelled!";
                            popupMessage.textContent =
                                "Your booking has been cancelled successfully.";

                            confirmCancel.style.display = "none";
                            keepBooking.style.display = "none";
                            doneButton.style.display = "inline-block";

                        } else {
                            popupTitle.textContent = "Cancellation Failed";
                            popupMessage.textContent = result;

                            confirmCancel.style.display = "none";
                            keepBooking.style.display = "none";
                            doneButton.style.display = "inline-block";
                        }

                    } catch (error) {
                        popupTitle.textContent = "Something Went Wrong";
                        popupMessage.textContent =
                            "Please try again.";

                        confirmCancel.style.display = "none";
                        keepBooking.style.display = "none";
                        doneButton.style.display = "inline-block";
                    }
                });
                doneButton.addEventListener("click", () => {
                    window.location.href = "/bookings/my-bookings";
                });
            }
        </script>

</body>

</html>