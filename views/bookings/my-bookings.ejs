<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Bookings</title>
    <link rel="stylesheet" href="/css/style.css">
</head>

<body>
    <%- include('../partials/navbar') %>
        <div class="my-bookings-container">
            <h1>My Bookings</h1>

            <% if (bookings.length===0) { %>

                <p>You have no bookings yet.</p>

                <% } else { %>

                    <% bookings.forEach(booking=> { %>

                        <div class="booking-card">
                            <h2>
                                <%= booking.movie ? booking.movie.title : "Movie unavailable" %>
                            </h2>

                            <% const showtime=booking.movie ? booking.movie.showtimes.id(booking.showtime) : null; %>

                                <p>
                                    Date:
                                    <%= showtime ? showtime.date.toDateString() : "Not available" %>
                                </p>

                                <p>
                                    Time:
                                    <%= showtime ? showtime.time : "Not available" %>
                                </p>

                                <p>Status: <%= booking.status %>
                                </p>

                                <a href="/bookings/<%= booking._id %>" class="booking-details-btn">View Details</a>
                        </div>

                        <% }) %>

                            <% } %>

                                <a href="/movies" class="back-to-movies">Back to Movies</a>

        </div>
</body>

</html>