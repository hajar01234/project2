<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= movie.title %>
    </title>
    <link rel="stylesheet" href="/css/style.css">
</head>

<body>
    <%- include('../partials/navbar') %>
        <div class="movie-details">

            <img src="<%= movie.poster %>" alt="<%= movie.title %>" class="movie-details-poster">

            <div class="movie-details-info">

                <h1>
                    <%= movie.title %>
                </h1>

                <p class="movie-description">
                    <%= movie.description %>
                </p>

                <p><strong>Genre:</strong>
                    <%= movie.genre %>
                </p>

                <p><strong>Duration:</strong>
                    <%= movie.duration %> minutes
                </p>

                <p><strong>Language:</strong>
                    <%= movie.language %>
                </p>

                <p><strong>Age Rating:</strong>
                    <%= movie.agerating %>
                </p>

                <p><strong>Price:</strong>
                    <%= movie.price %> BHD
                </p>

                <p><strong>Cast:</strong>
                    <%= movie.cast.join(", ") %></p>

    </div>

</div>

    <div class=" showtimes-section">

                        <h2>Showtimes</h2>

                        <div class="showtimes-list">

                            <% movie.showtimes.forEach(showtime=> { %>
                                <div class="showtime-card">

                                    <p>
                                        <strong>Date:</strong>
                                        <%= showtime.date.toDateString() %>
                                    </p>

                                    <p>
                                        <strong>Time:</strong>
                                        <%= showtime.time %>
                                    </p>

                                    <a href="/bookings/new/<%= movie._id %>/<%= showtime._id %>">
                                        <button type="button">Select Showtime</button>
                                    </a>

                                </div>

                                <% }) %>

                        </div>

            </div>

            <div class="back-to-movies">
                <a href="/movies"> ⬅Back to Movies</a>
            </div>
</body>

</html>